+        if (!references) delete this;
+        return references;
+    }
+    HRESULT STDMETHODCALLTYPE Invoke(IInspectable *sender, ISuspendingEventArgs *args) override {
+        return mFunction(sender, args);
+    }
+  private:
+    volatile LONG mReferences = 1;
+    Function mFunction;
+};
+template <class Function>
+ComPtr<IEventHandler<SuspendingEventArgs *>> phoneSuspendHandler(Function function) {
