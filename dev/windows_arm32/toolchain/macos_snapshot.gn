# Private GN toolchain for a macOS-hosted ARM32 Windows snapshot generator.
# The Windows engine and all installed compilers keep their own toolchains.
import("//build/toolchain/custom/custom.gni")

toolchain("custom") {
  driver = "\"$python_path\" \"${custom_toolchain}/driver.py\""
  foreach(kind,
          [
            "cc",
            "cxx",
            "asm",
            "objc",
            "objcxx",
          ]) {
    tool(kind) {
      flags = "{{cflags}}"
      if (kind == "cc") {
        flags += " {{cflags_c}}"
      } else if (kind == "asm") {
        flags += " {{asmflags}}"
      } else if (kind == "objc") {
        flags += " {{cflags_objc}}"
      } else if (kind == "objcxx") {
        flags += " {{cflags_objcc}}"
      } else {
        flags += " {{cflags_cc}}"
      }
      command = "$driver $kind -MMD -MF {{output}}.d {{defines}} {{include_dirs}} $flags -c {{source}} -o {{output}}"
      depfile = "{{output}}.d"
      depsformat = "gcc"
      outputs =
          [ "{{source_out_dir}}/{{target_output_name}}.{{source_name_part}}.o" ]
      description = "$kind {{output}}"
    }
  }
  tool("alink") {
    # These build-local archives reference their objects; only the linked
    # generator is distributed. Avoid duplicating all precompiler bitcode.
    command = "$driver ar rcsT {{output}} @{{output}}.rsp"
    rspfile = "{{output}}.rsp"
    rspfile_content = "{{inputs}}"
    outputs =
        [ "{{target_out_dir}}/{{target_output_name}}{{output_extension}}" ]
    default_output_extension = ".a"
    output_prefix = "lib"
    description = "AR {{output}}"
  }
  tool("link") {
    output = "{{output_dir}}/{{target_output_name}}{{output_extension}}"
    command = "$driver link {{ldflags}} -o $output @$output.rsp {{solibs}} {{libs}} {{frameworks}}"
    rspfile = "$output.rsp"
    rspfile_content = "{{inputs}}"
    outputs = [ output ]
    default_output_dir = "{{root_out_dir}}"
    description = "LINK $output"
    lib_switch = "-l"
    lib_dir_switch = "-L"
  }
  tool("solink") {
    output = "{{output_dir}}/{{target_output_name}}{{output_extension}}"
    command = "$driver solink -shared {{ldflags}} -Wl,-install_name,@rpath/{{target_output_name}}{{output_extension}} -o $output @$output.rsp {{solibs}} {{libs}} {{frameworks}}"
    rspfile = "$output.rsp"
    rspfile_content = "{{inputs}}"
    outputs = [ output ]
    default_output_dir = "{{root_out_dir}}"
    default_output_extension = ".dylib"
    output_prefix = "lib"
    link_output = output
    depend_output = output
    description = "DYLIB $output"
    lib_switch = "-l"
    lib_dir_switch = "-L"
  }
  tool("stamp") {
    command = "touch {{output}}"
  }
  tool("copy") {
    command = "cp -f {{source}} {{output}}"
  }
  toolchain_args = {
    current_os = target_os
    current_cpu = target_cpu
    is_clang = true
  }
}
