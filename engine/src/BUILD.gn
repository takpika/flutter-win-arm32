group("default") {
  testonly = true
  if (flutter_windows_phone) {
    deps = [ "//flutter/shell/platform/embedder:flutter_engine" ]
  } else if (target_os == "wasm") {
    deps = [ "//flutter/wasm" ]
  } else {
    deps = [ "//flutter" ]
  }
}

group("dist") {
  testonly = true

  if (target_os == "wasm") {
    deps = [ "//flutter/wasm" ]
  } else {
    deps = [ "//flutter:dist" ]
  }
}
