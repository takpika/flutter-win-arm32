# Windows ARM32 COFF cross-toolchain shared by Win32 and UWP.
template("windows_arm32_coff_toolchain") {
  driver_path = invoker.driver
  driver = "\"$python_path\" \"$driver_path\""
  toolchain(target_name) {
    toolchain_args = {
      current_os = "win"
      current_cpu = "arm"
    }
    foreach(kind,
            [
              "cc",
              "cxx",
              "asm",
            ]) {
      tool(kind) {
        flags = "{{cflags}}"
        if (kind == "cc") {
          flags = "-x c $flags {{cflags_c}}"
        } else if (kind == "cxx") {
          flags += " {{cflags_cc}}"
        } else {
          flags += " {{asmflags}}"
        }
        command = "$driver $kind {{defines}} {{include_dirs}} $flags -MMD -MF {{output}}.d -c {{source}} -o {{output}}"
        outputs = [
          "{{source_out_dir}}/{{target_output_name}}.{{source_name_part}}.obj",
        ]
        depfile = "{{output}}.d"
        depsformat = "gcc"
        description = "$kind {{output}}"
      }
    }
    tool("alink") {
      command = "$driver ar rcs {{output}} @{{output}}.rsp"
      rspfile = "{{output}}.rsp"
      rspfile_content = "{{inputs}}"
      outputs = [ "{{target_out_dir}}/{{target_output_name}}.lib" ]
      description = "AR {{output}}"
      default_output_dir = "{{target_out_dir}}"
    }
    tool("solink") {
      dll = "{{output_dir}}/{{target_output_name}}{{output_extension}}"
      implib = "{{output_dir}}/{{target_output_name}}.dll.lib"
      command =
          "$driver solink -shared -o $dll -Wl,--out-implib,$implib @$dll.rsp"
      rspfile = "$dll.rsp"
      rspfile_content = "{{inputs}} {{solibs}} {{libs}} {{ldflags}}"
      outputs = [
        dll,
        implib,
      ]
      link_output = implib
      depend_output = implib
      default_output_extension = ".dll"
      default_output_dir = "{{root_out_dir}}"
      description = "DLL $dll"
      lib_switch = "-l"
      lib_dir_switch = "-L"
    }
    tool("link") {
      output = "{{output_dir}}/{{target_output_name}}{{output_extension}}"
      command = "$driver link -o $output @$output.rsp"
      rspfile = "$output.rsp"
      rspfile_content = "{{inputs}} {{solibs}} {{libs}} {{ldflags}}"
      outputs = [ output ]
      default_output_extension = ".exe"
      default_output_dir = "{{root_out_dir}}"
      description = "LINK $output"
      lib_switch = "-l"
      lib_dir_switch = "-L"
    }
    tool("stamp") {
      command = "touch {{output}}"
      description = "STAMP {{output}}"
    }
    tool("copy") {
      command = "cp -f {{source}} {{output}}"
      description = "COPY {{output}}"
    }
  }
}
