  SendMessageW=MinUser.SendMessageW
  IsZoomed=FlutterWinRTIsZoomed
  GetSystemMetrics=MinUser.GetSystemMetrics
  MonitorFromWindow=MinUser.MonitorFromWindow
  GetMonitorInfoW=MinUser.GetMonitorInfoW
  PostMessageW=MinUser.PostMessageW
  SetWindowPos=MinUser.SetWindowPos
